[
  {"name": "json_request_pan_and_cardcode",
   "input": "{\"cardNumber\":\"4111111111111111\",\"expirationDate\":\"2027-12\",\"cardCode\":\"123\",\"amount\":\"10.00\"}",
   "expected": "{\"cardNumber\":\"************1111\",\"expirationDate\":\"2027-12\",\"cardCode\":\"***\",\"amount\":\"10.00\"}"},
  {"name": "form_spaced_pan_and_cvv",
   "input": "card=4111 1111 1111 1111&cvv=123&zip=10001",
   "expected": "card=**** **** **** 1111&cvv=***&zip=10001"},
  {"name": "amex_with_dashes",
   "input": "pan=3782-822463-10005",
   "expected": "pan=****-******-*0005"},
  {"name": "xml_gateway_payload",
   "input": "<creditCard><cardNumber>5555555555554444</cardNumber><cardCode>9876</cardCode></creditCard>",
   "expected": "<creditCard><cardNumber>************4444</cardNumber><cardCode>***</cardCode></creditCard>"},
  {"name": "two_pans_in_one_line",
   "input": "retry with 6011111111111117 after 2223003122003222 declined",
   "expected": "retry with ************1117 after ************3222 declined"},
  {"name": "unquoted_json_number_pan",
   "input": "{\"pan\":4012888888881881,\"cvv\":456}",
   "expected": "{\"pan\":************1881,\"cvv\":***}"},
  {"name": "plain_text_log",
   "input": "Card 4111-1111-1111-1111 exp 12/27 cvc=999 result=declined",
   "expected": "Card ****-****-****-1111 exp 12/27 cvc=*** result=declined"},
  {"name": "cvv_key_case_insensitive_with_space",
   "input": "{\"CVV\": 321, \"SecurityCode\":\"0042\"}",
   "expected": "{\"CVV\": ***, \"SecurityCode\":\"***\"}"},
  {"name": "form_key_at_start",
   "input": "securityCode=4321&name=Jo",
   "expected": "securityCode=***&name=Jo"},
  {"name": "keep_luhn_failing_order_number",
   "input": "{\"orderId\":\"4111111111111112\"}",
   "expected": "{\"orderId\":\"4111111111111112\"}"},
  {"name": "keep_prefix_7_even_if_luhn_valid",
   "input": "ref 7111111111111114",
   "expected": "ref 7111111111111114"},
  {"name": "keep_20_digit_run_even_if_luhn_valid",
   "input": "trace 41111111111111111115",
   "expected": "trace 41111111111111111115"},
  {"name": "keep_pan_inside_longer_digit_run",
   "input": "batch 994111111111111113",
   "expected": "batch 994111111111111113"},
  {"name": "keep_phone_and_timestamp",
   "input": "{\"phone\":\"+1 555-123-4567\",\"createdAt\":\"2026-11-23 16:42:00\"}",
   "expected": "{\"phone\":\"+1 555-123-4567\",\"createdAt\":\"2026-11-23 16:42:00\"}"},
  {"name": "keep_cvv_of_wrong_length",
   "input": "cvv=12345&cvc=12&{\"cvv\":\"12\"}",
   "expected": "cvv=12345&cvc=12&{\"cvv\":\"12\"}"},
  {"name": "keep_key_without_boundary",
   "input": "xcvv=123&notcvv=456",
   "expected": "xcvv=123&notcvv=456"},
  {"name": "keep_xml_cvv_with_whitespace",
   "input": "<cvv> 123 </cvv>",
   "expected": "<cvv> 123 </cvv>"},
  {"name": "already_masked_is_unchanged",
   "input": "{\"cardNumber\":\"************1111\",\"cvv\":\"***\"}",
   "expected": "{\"cardNumber\":\"************1111\",\"cvv\":\"***\"}"},
  {"name": "double_space_breaks_the_run",
   "input": "4111  1111 1111 1111",
   "expected": "4111  1111 1111 1111"},
  {"name": "empty_string",
   "input": "",
   "expected": ""}
